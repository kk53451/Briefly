# Briefly Flutter app — environment variables template
# 실제 값은 .env 파일에 채워서 사용 (.env는 gitignore)
# .env 는 pubspec.yaml assets 에 등록되어 빌드에 포함됨

# Supabase — Dashboard → Project Settings → API 에서 확인
# URL과 anon (publishable) 키만. service_role 키는 절대 여기 두지 말 것 (모바일 번들에 포함되면 즉시 유출).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-legacy-anon-key>

# Storage bucket 이름 (파이프라인과 동일)
SUPABASE_AUDIO_BUCKET=briefly-audio

# Google Sign-In
# Web client ID 는 Supabase Auth Dashboard의 Google provider 설정과 동일해야 함.
# iOS client ID 는 Google Cloud의 iOS OAuth 클라이언트 값.
# ios/Runner/Info.plist에도 REVERSED_CLIENT_ID URL scheme 등록 필요 (README 참고).
GOOGLE_WEB_CLIENT_ID=<google-web-client-id>.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=<google-ios-client-id>.apps.googleusercontent.com
