# Briefly backend — 환경변수 템플릿
# 실제 값은 .env 파일에 채워서 사용하세요 (.env는 gitignore)

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.4
OPENAI_JUDGE_MODEL=gpt-5.4

# Supabase
# - 같은 프로젝트의 URL과 legacy service_role JWT 키 사용
# - 현재 검증기는 sb_secret_... 형식을 지원하지 않음 (Flutter에 노출 금지)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<legacy-service-role-jwt>
SUPABASE_AUDIO_BUCKET=briefly-audio

# Ollama 헤드라인 생성 (피드만 실행해도 필요)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b-it-q4_K_M

# Discord 알림 (선택)
DISCORD_WEBHOOK_URL=
DISCORD_PIPELINE_WEBHOOK_URL=

# Grafana Loki 계측 (선택: URL·사용자·토큰이 모두 있을 때 활성화)
# URL은 https://logs-prod-XXX.grafana.net 같은 호스트 주소 (push 경로는 코드가 추가)
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_TOKEN=
GRAFANA_LOKI_ENV=prod
