# Supabase — from Dashboard → Project Settings → API
# EXPO_PUBLIC_* prefix is required for Expo to expose to client bundle.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Public audio bucket (matches backend_v2_supabase/app/db/migrations/0003_storage_bucket.sql)
EXPO_PUBLIC_SUPABASE_AUDIO_BUCKET=briefly-audio
