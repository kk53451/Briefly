# Briefly backend_v2_supabase — 환경변수 템플릿
# 실제 값은 .env 파일에 채워서 사용하세요 (.env는 gitignore)

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.4
OPENAI_JUDGE_MODEL=gpt-5.4

# Supabase
# - URL과 publishable(anon) 키는 Supabase Dashboard → Project Settings → API에서 확인
# - SERVICE_ROLE_KEY는 같은 페이지의 "service_role" 항목 (절대 클라이언트에 노출 금지)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
SUPABASE_AUDIO_BUCKET=briefly-audio

# Discord 알림 (선택)
DISCORD_WEBHOOK_URL=
DISCORD_PIPELINE_WEBHOOK_URL=
